OPENAI_API_KEY=
OPENAI_MODEL=
# Optional: falls back to OPENAI_MODEL
OPENAI_JUDGE_MODEL=
# reasoning 모델 추론 강도(기본 low). reasoning 미지원 모델이면 빈 값으로 둔다.
OPENAI_REASONING_EFFORT=low
TAVILY_API_KEY=
# Shared pacing within one process; 429 retries wait 15s, then 30s.
TAVILY_MIN_INTERVAL_SECONDS=1
TAVILY_RETRY_BACKOFF_SECONDS=15
CHROMA_PERSIST_DIRECTORY=data/chroma

# Optional
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ai-startup-investment
